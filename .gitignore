.cursor/

# PHP / XAMPP runtime artefacts
xampp-backend/project-eric-api/storage/
xampp-backend/**/*.log

# Database dumps (keep setup.sql)
database/*.sql.bak
*.sqlite
*.sqlite3

# Coursework / assessment deliverables (kept local only)
Project_Docs/
PART-B_*.md
PART-B_*.xlsx
PART-B_*.xml
build_report_docx.py
generate_partb_excel.py
generate_msproject_xml.py

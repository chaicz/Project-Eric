# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dev.log
dev-preview.log

# Environment files (keep .env.example only)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Cursor local data
.cursor/

# PHP / XAMPP runtime artefacts
xampp-backend/project-eric-api/storage/
xampp-backend/**/*.log

# Database dumps (keep setup.sql)
database/*.sql.bak
*.sqlite
*.sqlite3

# Coursework / assessment deliverables (kept local only)
Project_Docs/
PART-B_*.md
PART-B_*.xlsx
PART-B_*.xml
build_report_docx.py
generate_partb_excel.py
generate_msproject_xml.py
inspect_template.py
verify_docx.py

# Coverage / cache
coverage/
.cache/
.parcel-cache/

# Vendored upstream / downloaded binaries
# (keep our own extensions/* source, but exclude the Cline upstream monorepo
#  and the .vsix files that come from open-vsx.org / the marketplace)
extensions/vscode-cline/cline-main/
extensions/cline.zip
extensions/*.vsix

# Packaged extension builds (output of `npm run owasp:package`)
artifacts/

# Local dev / runtime logs
logs/
*.err

# Y.js runtime data — these are session-state files written by the collab
# server at runtime. Never commit them.
.yjs-data/
**/.yjs-data/
extensions/eric-collab/.yjs-data/

# Test output bundles (regenerated by `node scripts/verify-examples.js`)
out-test/

# Uploaded profile pictures. The folder itself and its .htaccess are
# tracked, but the images the API writes at runtime are not.
xampp-backend/project-eric-api/uploads/avatars/*
!xampp-backend/project-eric-api/uploads/avatars/.gitkeep

# Stray local files
backyard-birds.html
.vite-index.html

# Scratch / debug tooling (one-off probes and investigation scripts)
scripts/_tmp_*
scripts/tmp-*
scripts/unicode-test.pdf
extensions/eric-collab/scripts/tmp-*
extensions/project-eric-owasp/scripts/tmp-*

# Vendored third-party checkouts (pulled in locally, not authored here)
vendor/
.billd-data/
.tmp-billd-*/

# Generated test/audit output (regenerated by the scripts in scripts/)
reports/.tmp-*
reports/_tmp_*
reports/ui-capture/_check-*
reports/ui-capture/_crop-*
reports/ui-capture/_tmp_*

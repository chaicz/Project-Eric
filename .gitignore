# Coverage / cache
coverage/
.cache/
.parcel-cache/

# Vendored upstream / downloaded binaries
# (keep our own extensions/* source, but exclude the Cline upstream monorepo
#  and the .vsix files that come from open-vsx.org / the marketplace)
extensions/vscode-cline/cline-main/
extensions/cline.zip
extensions/*.vsix

# Packaged extension builds (output of `npm run owasp:package`)
artifacts/

# Local dev / runtime logs
logs/
*.err

# Y.js runtime data — these are session-state files written by the collab
# server at runtime. Never commit them.
.yjs-data/
**/.yjs-data/
extensions/eric-collab/.yjs-data/

# Test output bundles (regenerated by `node scripts/verify-examples.js`)
out-test/

# Stray local files
backyard-birds.html
.vite-index.html

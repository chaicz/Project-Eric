{
  "name": "project-eric",
  "private": true,
  "version": "1.0.0",
  "description": "Project Eric — Security-First Web IDE with integrated OWASP Top 10 (2021) analysis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ide:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-ide.ps1",
    "ide:start": "powershell -ExecutionPolicy Bypass -File scripts/start-ide.ps1",
    "ide:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-ide.ps1 -Stop",
    "ide:status": "powershell -ExecutionPolicy Bypass -File scripts/start-ide.ps1 -Status",
    "yjs:start": "node extensions/eric-collab/scripts/yjs-server.js",
    "yjs:dev": "cross-env PORT=1234 DATA_DIR=./.yjs-data node extensions/eric-collab/scripts/yjs-server.js"
  },
  "dependencies": {
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "three": "^0.160.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.15"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}

{
  "name": "project-eric",
  "private": true,
  "version": "1.1.0",
  "description": "Project Eric — Security-First Web IDE with integrated OWASP Top 10 (2026) analysis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ide:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-ide.ps1",
    "ide:start": "powershell -ExecutionPolicy Bypass -File scripts/start-ide.ps1",
    "ide:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-ide.ps1 -Stop",
    "ide:status": "powershell -ExecutionPolicy Bypass -File scripts/start-ide.ps1 -Status",
    "run:project": "powershell -ExecutionPolicy Bypass -File scripts/run-project.ps1",
    "run:project:no-relay": "powershell -ExecutionPolicy Bypass -File scripts/run-project.ps1 -NoRelay",
    "run:project:stop": "powershell -ExecutionPolicy Bypass -File scripts/run-project.ps1 -Stop",
    "run:project:status": "powershell -ExecutionPolicy Bypass -File scripts/run-project.ps1 -Status",
    "relay:start": "node scripts/p2p-relay-server.mjs --port 1235",
    "relay:test": "node scripts/test-p2p-relay.mjs",
    "test": "node --import ./tests/helpers/setup.mjs --test \"tests/unit/*.test.mjs\"",
    "test:unit": "node --import ./tests/helpers/setup.mjs --test \"tests/unit/*.test.mjs\"",
    "test:all": "node scripts/run-all-tests.cjs",
    "test:hard-mode": "node tests/owasp-hard-mode/run-hard-mode-tests.mjs",
    "test:hard-mode:verbose": "node tests/owasp-hard-mode/run-hard-mode-tests.mjs --verbose",
    "test:routes": "node scripts/check-route-coverage.cjs",
    "test:e2e": "node scripts/e2e-walkthrough.cjs",
    "test:recorded": "node scripts/recorded-walkthrough.cjs",
    "test:report": "node scripts/build-test-report.cjs",
    "test:lang-packs": "node scripts/test-language-packs.cjs",
    "test:lang-packs:installed": "node scripts/test-installed-language-packs.cjs",
    "test:lang-packs:runtime": "node scripts/test-code-server-language-packs.cjs",
    "lang-packs:build": "node scripts/build-language-packs.cjs",
    "test:owasp": "node scripts/test-owasp-10-languages.cjs",
    "test:owasp:secure": "node scripts/test-owasp-secure-clean.cjs",
    "p2p:test:4up": "node extensions/p2p-live-share/node_modules/tsx/dist/cli.mjs scripts/test-p2p-live-share-4up.mts",
    "yjs:start": "node extensions/eric-collab/scripts/yjs-server.js",
    "owasp:package": "cd extensions/project-eric-owasp && npx vsce package -o ../../artifacts --allow-missing-repository",
    "owasp:build": "cd extensions/project-eric-owasp && npm run compile && npm run build:standalone",
    "owasp:deploy": "node scripts/deploy-owasp-extension.cjs",
    "owasp:test": "node scripts/owasp-standalone-test.cjs",
    "owasp:install-vscode": "powershell -Command \"& { $vsix = Get-ChildItem artifacts/*.vsix -ErrorAction SilentlyContinue | Select-Object -First 1; if ($vsix) { Start-Process 'code' -ArgumentList '--install-extension', $vsix.FullName } else { Write-Error 'Run npm run owasp:package first' } }\"",
    "owasp:cs-install": "powershell -Command \"& { $vsix = Get-ChildItem artifacts/*.vsix -ErrorAction SilentlyContinue | Select-Object -First 1; if ($vsix) { $cs = 'C:\\tools\\code-server\\bin\\code-server.exe'; if (Test-Path $cs) { & $cs --install-extension $vsix.FullName } else { Write-Error 'code-server not installed. Run npm run ide:setup first.' } } else { Write-Error 'Run npm run owasp:package first.' } }\""
  },
  "dependencies": {
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.160.0",
    "ws": "^8.22.1",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.15"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}

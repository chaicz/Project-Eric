# Uploaded avatars are user-supplied files.
#
# They are validated by the API before they are written, but this folder
# must never be able to execute code even if a file slips through: no
# handler is registered for these extensions, and the listing is off.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI

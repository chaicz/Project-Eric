{
  "name": "project-eric-owasp",
  "displayName": "Project Eric — OWASP Security Scanner",
  "description": "Scans your code against the OWASP Top 10 (2026), surfaces a security score, lists vulnerabilities, and offers one-click improvements. Works in vscode.dev, desktop VS Code, and GitHub Codespaces.",
  "version": "0.1.0",
  "publisher": "project-eric",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Security",
    "Linters"
  ],
  "keywords": [
    "owasp",
    "security",
    "scanner",
    "sast",
    "vulnerability",
    "web-security",
    "top-10",
    "code-quality"
  ],
  "homepage": "https://github.com/project-eric/project-eric-owasp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-eric/project-eric-owasp.git"
  },
  "bugs": {
    "url": "https://github.com/project-eric/project-eric-owasp/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:php",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:ruby",
    "onLanguage:sql",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:html",
    "onLanguage:css",
    "onWorkspaceContains:**/*.{js,ts,py,java,php,go,rs,rb,sql,cpp,cs,html,css}",
    "onCommand:projectEric.security.scanKeyCode",
    "onCommand:projectEric.security.scanKeyCodeAsMcp",
    "onCommand:projectEric.security.scanMcpServer",
    "onCommand:projectEric.security.scanFile",
    "onCommand:projectEric.security.scanWorkspace",
    "onCommand:projectEric.security.openDashboard",
    "onCommand:projectEric.security.openStandaloneScanner",
    "onView:projectEric.securityView"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.web.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "projectEric.security.scanKeyCode",
        "title": "Project Eric: Scan Key Code",
        "shortTitle": "Scan Key Code",
        "category": "Project Eric",
        "icon": "$(shield)"
      },
      {
        "command": "projectEric.security.scanKeyCodeAsMcp",
        "title": "Project Eric: Scan Key Code (MCP rules)",
        "shortTitle": "Scan as MCP",
        "category": "Project Eric",
        "icon": "$(radio-tower)"
      },
      {
        "command": "projectEric.security.openStandaloneScanner",
        "title": "Project Eric: Open Standalone Scanner (function)",
        "shortTitle": "Open Standalone Scanner",
        "category": "Project Eric",
        "icon": "$(beaker)"
      },
      {
        "command": "projectEric.security.scanFile",
        "title": "Project Eric: Scan Current File",
        "category": "Project Eric",
        "icon": "$(shield)"
      },
      {
        "command": "projectEric.security.scanWorkspace",
        "title": "Project Eric: Scan Workspace",
        "category": "Project Eric",
        "icon": "$(shield)"
      },
      {
        "command": "projectEric.security.openDashboard",
        "title": "Project Eric: Open Security Dashboard",
        "category": "Project Eric",
        "icon": "$(dashboard)"
      },
      {
        "command": "projectEric.security.toggleAutoscan",
        "title": "Project Eric: Toggle Auto-scan on Save",
        "category": "Project Eric"
      },
      {
        "command": "projectEric.security.applyFix",
        "title": "Project Eric: Apply Suggested Fix",
        "category": "Project Eric"
      },
      {
        "command": "projectEric.security.markFalsePositive",
        "title": "Project Eric: Mark Finding as False Positive",
        "category": "Project Eric"
      },
      {
        "command": "projectEric.security.openDocs",
        "title": "Project Eric: Open OWASP Docs",
        "category": "Project Eric"
      },
      {
        "command": "projectEric.security.refresh",
        "title": "Project Eric: Refresh",
        "category": "Project Eric"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectEric.securityContainer",
          "title": "Project Eric Security",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "projectEric.securityContainer": [
        {
          "id": "projectEric.securityView",
          "name": "Findings",
          "icon": "media/icon.png",
          "contextualTitle": "Project Eric Security"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectEric.securityView",
        "contents": "Welcome to Project Eric — OWASP Security Scanner\n\n[Project Eric: Scan Key Code](command:projectEric.security.scanKeyCode)\n[Project Eric: Scan Key Code (MCP rules)](command:projectEric.security.scanKeyCodeAsMcp)\n[Project Eric: Open Standalone Scanner](command:projectEric.security.openStandaloneScanner)\n[Project Eric: Open Security Dashboard](command:projectEric.security.openDashboard)\n[Project Eric: Scan Current File](command:projectEric.security.scanFile)\n[Project Eric: Scan Workspace](command:projectEric.security.scanWorkspace)\n\nPress Ctrl+Shift+K to scan the active file at any time.\n\nUse `Project Eric: Open Standalone Scanner` for the function-style webview that runs `ProjectEric.scan(code, language)` directly inside code-server."
      }
    ],
    "walkthroughs": [
      {
        "id": "projectEric.getStarted",
        "title": "Project Eric — OWASP Security",
        "description": "Scan your code against the OWASP Top 10 (2026) right inside code-server.",
        "steps": [
          {
            "id": "projectEric.welcome",
            "title": "scanKeyCode() — the function",
            "description": "The scanner is now a function inside code-server, not a separate server. Press **Ctrl+Shift+K** with any file open, or click the shield in the activity bar to run it.\n\n[Project Eric: Scan Key Code](command:projectEric.security.scanKeyCode)",
            "media": { "image": "media/icon.png", "altText": "Project Eric shield" }
          },
          {
            "id": "projectEric.standalone",
            "title": "Open the Standalone Scanner",
            "description": "A code-server webview with a textarea and the bundled `ProjectEric.scan()` runtime. Paste code or pull from the active editor, then click **Scan**.\n\n[Project Eric: Open Standalone Scanner](command:projectEric.security.openStandaloneScanner)",
            "media": { "image": "media/icon.png", "altText": "Project Eric scanner" }
          },
          {
            "id": "projectEric.dashboard",
            "title": "Open the Security Dashboard",
            "description": "Per-file scores, OWASP coverage, and one-click improvements for the whole workspace.\n\n[Project Eric: Open Security Dashboard](command:projectEric.security.openDashboard)",
            "media": { "image": "media/icon.png", "altText": "Project Eric dashboard" }
          },
          {
            "id": "projectEric.workspace",
            "title": "Scan the whole workspace",
            "description": "Run a single scan over the workspace and surface every finding in the tree view.\n\n[Project Eric: Scan Workspace](command:projectEric.security.scanWorkspace)",
            "media": { "image": "media/icon.png", "altText": "Project Eric workspace scan" }
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectEric.security.scanWorkspace",
          "when": "view == projectEric.securityView",
          "group": "navigation"
        },
        {
          "command": "projectEric.security.refresh",
          "when": "view == projectEric.securityView",
          "group": "navigation"
        },
        {
          "command": "projectEric.security.openDashboard",
          "when": "view == projectEric.securityView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "projectEric.security.applyFix",
          "when": "view == projectEric.securityView && viewItem == findingWithFix",
          "group": "inline"
        },
        {
          "command": "projectEric.security.markFalsePositive",
          "when": "view == projectEric.securityView && viewItem =~ /^finding/",
          "group": "inline"
        },
        {
          "command": "projectEric.security.openDocs",
          "when": "view == projectEric.securityView && viewItem =~ /^finding/",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "projectEric.security.scanKeyCode",
          "when": "editorLangId =~ /^(javascript|typescript|python|java|php|go|rust|ruby|sql|cpp|csharp|html|css)$/",
          "group": "9_security"
        },
        {
          "command": "projectEric.security.scanFile",
          "when": "editorLangId =~ /^(javascript|typescript|python|java|php|go|rust|ruby|sql|cpp|csharp|html|css)$/",
          "group": "9_security"
        }
      ],
      "commandPalette": [
        {
          "command": "projectEric.security.toggleAutoscan",
          "when": "config.projectEric.autoScan"
        }
      ]
    },
    "languages": [
      {
        "id": "owasp-severity",
        "configuration": "./data/owasp-severity.language-configuration.json"
      }
    ],
    "problemMatchers": [
      {
        "label": "project-eric-owasp",
        "owner": "projectEric",
        "pattern": [
          {
            "regexp": "^(.+)\\((\\d+),(\\d+)\\):\\s+(error|warning|info)\\s+(\\w+-\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "code": 5,
            "message": 6
          }
        ]
      }
    ],
    "configuration": {
      "title": "Project Eric Security",
      "properties": {
        "projectEric.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan the active file on save."
        },
        "projectEric.minSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "default": "low",
          "description": "Minimum severity to surface as a diagnostic."
        },
        "projectEric.enabledCategories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "A01",
              "A02",
              "A03",
              "A04",
              "A05",
              "A06",
              "A07",
              "A08",
              "A09",
              "A10"
            ]
          },
          "default": [
            "A01",
            "A02",
            "A03",
            "A04",
            "A05",
            "A06",
            "A07",
            "A08",
            "A09",
            "A10"
          ],
          "description": "OWASP Top 10 categories to scan."
        },
        "projectEric.languages": {
          "type": "array",
          "items": "string",
          "default": [
            "javascript",
            "typescript",
            "python",
            "java",
            "php",
            "go",
            "rust",
            "ruby",
            "sql",
            "cpp",
            "csharp",
            "html",
            "css"
          ],
          "description": "Languages to scan."
        },
        "projectEric.scanOnType": {
          "type": "boolean",
          "default": false,
          "description": "Scan while you type. Off by default to keep typing snappy."
        },
        "projectEric.excludePatterns": {
          "type": "array",
          "items": "string",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**",
            "**/vendor/**",
            "**/coverage/**",
            "**/__snapshots__/**"
          ],
          "description": "Glob patterns to exclude from workspace scans."
        },
        "projectEric.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Optional Project Eric backend URL for AI explanations and online rule updates."
        },
        "projectEric.sharingEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Anonymously share findings with the Project Eric rule engine to improve detection."
        }
      }
    },
    "keybindings": [
      {
        "command": "projectEric.security.scanKeyCode",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus"
      },
      {
        "command": "projectEric.security.scanMcpServer",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "projectEric.security.scanFile",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "projectEric.security.openDashboard",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:standalone",
    "compile": "tsc -p tsconfig.json && node scripts/build-browser.js",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "test": "node scripts/test-scanner.js && node scripts/verify-examples.js && node scripts/smoke-standalone.js",
    "test:scanner": "node scripts/test-scanner.js",
    "test:examples": "node scripts/verify-examples.js",
    "test:standalone": "node scripts/smoke-standalone.js",
    "package": "vsce package",
    "build:web": "node scripts/build-browser.js",
    "build:standalone": "node scripts/build-standalone.js",
    "build:all": "npm run compile && npm run build:standalone"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.4",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}

      ]
    },
    {
      "id": "A10-JAVASCRIPT-009",
      "name": "Server-Side Request Forgery (SSRF) — fetch/axios from request data",
      "summary": "2 patterns match server-side request forgery (ssrf) in JavaScript.",
      "description": "Validate and allowlist outbound URLs, resolve DNS yourself to block private/loopback addresses, and disable HTTP redirections on the HTTP client.",
      "severity": "high",
      "category": "A10",
      "cwe": [
        "CWE-918"
      ],
      "patterns": [
        {
          "description": "fetch/axios from request data",
          "regex": "\\b(?:fetch|axios|got|request)\\s*\\(\\s*(?:req\\.|ctx\\.|input|body|data)",
          "flags": "g"
        },
        {
          "description": "fetch/axios from variable",
          "regex": "\\b(?:fetch|axios|got|request)\\s*\\(\\s*[a-zA-Z_][\\w.]*\\s*\\)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Server-Side Request Forgery (SSRF)",
        "hint": "Validate and allowlist outbound URLs, resolve DNS yourself to block private/loopback addresses, and disable HTTP redirections on the HTTP client.",
        "docUrl": "https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A10",
          "url": "https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/"
        },
        {
          "label": "CWE-918",
          "url": "https://cwe.mitre.org/data/definitions/918.html"
        }
      ]
    }
  ]

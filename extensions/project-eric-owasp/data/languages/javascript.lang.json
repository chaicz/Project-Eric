        }
      ]
    },
    {
      "id": "A09-JAVASCRIPT-008",
      "name": "Security Logging and Monitoring Failures — console.* usage",
      "summary": "console.* usage detected in JavaScript source.",
      "description": "Add structured logging on auth, authorization and data-modification events with user id, IP and timestamp.",
      "severity": "low",
      "category": "A09",
      "cwe": [
        "CWE-117",
        "CWE-223",
        "CWE-532",
        "CWE-778"
      ],
      "patterns": [
        {
          "description": "console.* usage",
          "regex": "console\\.(log|info|warn|error)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Security Logging and Monitoring Failures",
        "hint": "Add structured logging on auth, authorization and data-modification events with user id, IP and timestamp.",
        "docUrl": "https://owasp.org/Top10/A09_2021-Security_Logging_and_Monitoring_Failures/"
      },
      "safeToAutoFix": false,
      "references": [

      ]
    },
    {
      "id": "A10-RUST-006",
      "name": "Server-Side Request Forgery (SSRF) — reqwest outbound",
      "summary": "reqwest outbound detected in Rust source.",
      "description": "Validate and allowlist outbound URLs. Resolve DNS yourself to block private IPs.",
      "severity": "high",
      "category": "A10",
      "cwe": [
        "CWE-918"
      ],
      "patterns": [
        {
          "description": "reqwest outbound",
          "regex": "reqwest::(?:get|Client::new|Client::builder)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Server-Side Request Forgery (SSRF)",
        "hint": "Validate and allowlist outbound URLs. Resolve DNS yourself to block private IPs.",
        "docUrl": "https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/"
      },
      "safeToAutoFix": false,
      "references": [

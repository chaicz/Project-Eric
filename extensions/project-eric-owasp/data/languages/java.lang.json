{
  "id": "java",
  "label": "Java",
  "extensions": [
    "java"
  ],
  "flags": "g",
  "rules": [
    {
      "id": "A01-JAVA-001",
      "name": "Broken Access Control — Spring mapping with id path variable",
      "summary": "2 patterns match broken access control in Java.",
      "description": "Add method-level @PreAuthorize / @PostAuthorize (Spring Security). Verify ownership in the service layer. Deny by default with a global SecurityFilterChain.",
      "severity": "high",
      "category": "A01",
      "cwe": [
        "CWE-22",
        "CWE-285",
        "CWE-639",
        "CWE-862",
        "CWE-863"
      ],
      "patterns": [
        {
          "description": "Spring mapping with id path variable",
          "regex": "@(?:GetMapping|PostMapping|PutMapping|DeleteMapping|RequestMapping)\\s*\\([^)]*\\b(?:id|userId)\\b[^)]*\\)",
          "flags": "g"
        },
        {
          "description": "@PathVariable id",
          "regex": "@PathVariable\\s+(?:Long|String|Integer)\\s+(?:id|userId)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Broken Access Control",
        "hint": "Add method-level @PreAuthorize / @PostAuthorize (Spring Security). Verify ownership in the service layer. Deny by default with a global SecurityFilterChain.",
        "docUrl": "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A01",
          "url": "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
        },
        {
          "label": "CWE-22",
          "url": "https://cwe.mitre.org/data/definitions/22.html"
        },
        {
          "label": "CWE-285",
          "url": "https://cwe.mitre.org/data/definitions/285.html"
        },
        {
          "label": "CWE-639",
          "url": "https://cwe.mitre.org/data/definitions/639.html"
        }
      ]
    },
    {
      "id": "A02-JAVA-002",
      "name": "Cryptographic Failures — MessageDigest with MD5/SHA-1",
      "summary": "2 patterns match cryptographic failures in Java.",
      "description": "Use BCrypt / Argon2 (Spring Security Crypto). Pin MessageDigest to SHA-256+. Move secrets to env / Vault.",
      "severity": "critical",
      "category": "A02",
      "cwe": [
        "CWE-261",
        "CWE-296",
        "CWE-310",
        "CWE-319",
        "CWE-321",
        "CWE-326",
        "CWE-327",
        "CWE-328",
        "CWE-330",
        "CWE-916"
      ],
      "patterns": [
        {
          "description": "MessageDigest with MD5/SHA-1",
          "regex": "MessageDigest\\.getInstance\\(\\s*['\"](?:MD5|SHA-?1)['\"]",
          "flags": "g"
        },
        {
          "description": "Hardcoded credential literal",
          "regex": "(?:api[_-]?key|secret|token|password|passwd|pwd)\\s*[:=]\\s*['\"]([^'\"]{8,})['\"]",
          "flags": "gi"
        }
      ],
      "fix": {
        "title": "Remediate Cryptographic Failures",
        "hint": "Use BCrypt / Argon2 (Spring Security Crypto). Pin MessageDigest to SHA-256+. Move secrets to env / Vault.",
        "docUrl": "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A02",
          "url": "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/"
        },
        {
          "label": "CWE-261",
          "url": "https://cwe.mitre.org/data/definitions/261.html"
        },
        {
          "label": "CWE-296",
          "url": "https://cwe.mitre.org/data/definitions/296.html"
        },
        {
          "label": "CWE-310",
          "url": "https://cwe.mitre.org/data/definitions/310.html"
        }
      ]
    },
    {
      "id": "A03-JAVA-003",
      "name": "Injection — Statement (not PreparedStatement)",
      "summary": "3 patterns match injection in Java.",
      "description": "Use `PreparedStatement` with bind variables. Avoid Runtime.exec / ProcessBuilder with user-supplied argv. Run on a allowlisted command list.",
      "severity": "critical",
      "category": "A03",
      "cwe": [
        "CWE-20",
        "CWE-74",
        "CWE-75",
        "CWE-77",
        "CWE-78",
        "CWE-79",
        "CWE-80",
        "CWE-83",
        "CWE-87",
        "CWE-88",
        "CWE-89",
        "CWE-91",
        "CWE-94",
        "CWE-95",
        "CWE-96",
        "CWE-97",
        "CWE-98",
        "CWE-113",
        "CWE-116",
        "CWE-138"
      ],
      "patterns": [
        {
          "description": "Statement (not PreparedStatement)",
          "regex": "createStatement\\s*\\(\\s*\\)",
          "flags": "g"
        },
        {
          "description": "Runtime.exec()",
          "regex": "\\bRuntime\\.getRuntime\\s*\\(\\s*\\)\\.exec\\s*\\(",
          "flags": "g"
        },
        {
          "description": "ProcessBuilder",
          "regex": "\\bProcessBuilder\\s*\\(\\s*[\"'](?:sh|bash|cmd|powershell)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Injection",
        "hint": "Use `PreparedStatement` with bind variables. Avoid Runtime.exec / ProcessBuilder with user-supplied argv. Run on a allowlisted command list.",
        "docUrl": "https://owasp.org/Top10/A03_2021-Injection/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A03",
          "url": "https://owasp.org/Top10/A03_2021-Injection/"
        },
        {
          "label": "CWE-20",

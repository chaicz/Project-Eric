        },
        {
          "label": "CWE-13",
          "url": "https://cwe.mitre.org/data/definitions/13.html"
        }
      ]
    },
    {
      "id": "A07-PYTHON-006",
      "name": "Identification and Authentication Failures — Plain password compare",
      "summary": "2 patterns match identification and authentication failures in Python.",
      "description": "Use `bcrypt.checkpw` / `argon2.verify` / Django's `check_password`. Enforce MFA via WebAuthn / TOTP (pyotp).",
      "severity": "high",
      "category": "A07",
      "cwe": [
        "CWE-255",
        "CWE-259",
        "CWE-287",
        "CWE-288",
        "CWE-290",
        "CWE-294",
        "CWE-295",
        "CWE-297",
        "CWE-300",
        "CWE-302",
        "CWE-304",
        "CWE-306",
        "CWE-307",
        "CWE-346",
        "CWE-384",
        "CWE-521",
        "CWE-613",
        "CWE-620",
        "CWE-640",
        "CWE-798",
        "CWE-940",
        "CWE-1216"
      ],
      "patterns": [
        {
          "description": "Plain password compare",
          "regex": "(?:password|passwd|pwd)\\s*===?\\s*(?:req\\.body|user\\.|input)",
          "flags": "g"
        },
        {
          "description": "Weak hash on password",
          "regex": "\\b(?:md5|sha1)\\s*\\(\\s*(?:password|user\\.|request\\.form|request\\.json)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Identification and Authentication Failures",
        "hint": "Use `bcrypt.checkpw` / `argon2.verify` / Django's `check_password`. Enforce MFA via WebAuthn / TOTP (pyotp).",
        "docUrl": "https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A07",

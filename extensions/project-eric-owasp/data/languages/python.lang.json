    {
      "id": "A09-PYTHON-008",
      "name": "Security Logging and Monitoring Failures — console.* usage",
      "summary": "2 patterns match security logging and monitoring failures in Python.",
      "description": "Use the `logging` module. Log auth, authorization and admin events with user id, IP and timestamp. Never log passwords or tokens.",
      "severity": "low",
      "category": "A09",
      "cwe": [
        "CWE-117",
        "CWE-223",
        "CWE-532",
        "CWE-778"
      ],
      "patterns": [

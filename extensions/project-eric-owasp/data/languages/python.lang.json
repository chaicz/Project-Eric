        },
        {
          "label": "CWE-259",
          "url": "https://cwe.mitre.org/data/definitions/259.html"
        },
        {
          "label": "CWE-287",
          "url": "https://cwe.mitre.org/data/definitions/287.html"
        }
      ]
    },
    {
      "id": "A08-PYTHON-007",
      "name": "Software and Data Integrity Failures — pickle.load(s) on untrusted data",
      "summary": "2 patterns match software and data integrity failures in Python.",
      "description": "Never unpickle untrusted bytes. Use `yaml.safe_load`. If you must use pickle, gate it behind HMAC + signature verification.",
      "severity": "high",
      "category": "A08",
      "cwe": [
        "CWE-345",
        "CWE-353",
        "CWE-426",
        "CWE-502",
        "CWE-565",
        "CWE-784",
        "CWE-829",
        "CWE-830",
        "CWE-915"
      ],
      "patterns": [
        {
          "description": "pickle.load(s) on untrusted data",
          "regex": "\\bpickle\\.(?:load|loads)\\s*\\(",
          "flags": "g"
        },
        {
          "description": "yaml.load() — use yaml.safe_load",
          "regex": "\\byaml\\.load\\s*\\([^)]*\\)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Software and Data Integrity Failures",
        "hint": "Never unpickle untrusted bytes. Use `yaml.safe_load`. If you must use pickle, gate it behind HMAC + signature verification.",

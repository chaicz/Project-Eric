    {
      "id": "A10-PYTHON-009",
      "name": "Server-Side Request Forgery (SSRF) — HTTP call with dynamic URL",
      "summary": "2 patterns match server-side request forgery (ssrf) in Python.",
      "description": "Validate and allowlist outbound URLs. Resolve DNS yourself to block private/loopback addresses (169.254.169.254, 127.0.0.0/8, 10.0.0.0/8).",
      "severity": "high",
      "category": "A10",
      "cwe": [
        "CWE-918"
      ],
      "patterns": [
        {
          "description": "HTTP call with dynamic URL",
          "regex": "\\b(?:requests|httpx|aiohttp|urllib\\.request)\\.\\w+\\s*\\(\\s*(?:url|\\w*[Uu]rl)\\s*=",
          "flags": "g"
        },
        {
          "description": "urlopen from variable",
          "regex": "\\burlopen\\s*\\(\\s*[a-zA-Z_][\\w.]*\\s*\\)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Server-Side Request Forgery (SSRF)",
        "hint": "Validate and allowlist outbound URLs. Resolve DNS yourself to block private/loopback addresses (169.254.169.254, 127.0.0.0/8, 10.0.0.0/8).",
        "docUrl": "https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A10",
          "url": "https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/"

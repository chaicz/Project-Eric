{
  "id": "python",
  "label": "Python",
  "extensions": [
    "py"
  ],
  "flags": "g",
  "rules": [
    {
      "id": "A01-PYTHON-001",
      "name": "Broken Access Control — Flask/FastAPI route reads :id",
      "summary": "3 patterns match broken access control in Python.",
      "description": "Deny by default. Verify ownership / role on every route that reads a user id. Use Flask-Login / FastAPI dependencies and a per-object permission check (e.g. Pundit-style policy).",
      "severity": "high",
      "category": "A01",
      "cwe": [
        "CWE-22",
        "CWE-285",
        "CWE-639",
        "CWE-862",
        "CWE-863"
      ],
      "patterns": [
        {
          "description": "Flask/FastAPI route reads :id",
          "regex": "@(?:app|router)\\.(get|post|put|delete|patch)\\s*\\(\\s*['\"`][^'\"`]*<[^>]*?(?:id|user_id|pk)[^>]*>",
          "flags": "g"
        },
        {
          "description": "Reads id from request args",
          "regex": "request\\.args\\.get\\(['\"](?:id|user_id|pk)['\"]",
          "flags": "g"
        },
        {
          "description": "Loads object without checking ownership",
          "regex": "get_object_or_404\\(\\s*[A-Z][A-Za-z]+,",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Broken Access Control",
        "hint": "Deny by default. Verify ownership / role on every route that reads a user id. Use Flask-Login / FastAPI dependencies and a per-object permission check (e.g. Pundit-style policy).",
        "docUrl": "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A01",
          "url": "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
        },
        {
          "label": "CWE-22",
          "url": "https://cwe.mitre.org/data/definitions/22.html"
        },
        {
          "label": "CWE-285",
          "url": "https://cwe.mitre.org/data/definitions/285.html"
        },
        {
          "label": "CWE-639",
          "url": "https://cwe.mitre.org/data/definitions/639.html"
        }
      ]
    },
    {
      "id": "A02-PYTHON-002",
      "name": "Cryptographic Failures — hashlib.md5 / hashlib.sha1",
      "summary": "4 patterns match cryptographic failures in Python.",
      "description": "Use bcrypt / argon2 (passlib.hash) for passwords, sha-256+ for general hashing. Use `secrets` module for tokens. Load secrets from env / vault.",
      "severity": "critical",
      "category": "A02",
      "cwe": [
        "CWE-261",
        "CWE-296",
        "CWE-310",
        "CWE-319",
        "CWE-321",
        "CWE-326",
        "CWE-327",
        "CWE-328",
        "CWE-330",
        "CWE-916"
      ],
      "patterns": [
        {
          "description": "hashlib.md5 / hashlib.sha1",
          "regex": "hashlib\\.(?:md5|sha1)",
          "flags": "g"
        },
        {
          "description": "Weak hash algorithm",
          "regex": "\\b(?:md5|sha1)\\s*\\(",
          "flags": "g"
        },
        {
          "description": "Hardcoded credential literal",
          "regex": "(?:api[_-]?key|secret|token|password|passwd|pwd)\\s*[:=]\\s*['\"]([^'\"]{8,})['\"]",
          "flags": "gi"
        },
        {
          "description": "non-csprng random module",
          "regex": "random\\.random\\(|random\\.randint\\(",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Cryptographic Failures",
        "hint": "Use bcrypt / argon2 (passlib.hash) for passwords, sha-256+ for general hashing. Use `secrets` module for tokens. Load secrets from env / vault.",
        "docUrl": "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A02",
          "url": "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/"
        },
        {
          "label": "CWE-261",
          "url": "https://cwe.mitre.org/data/definitions/261.html"
        },
        {
          "label": "CWE-296",
          "url": "https://cwe.mitre.org/data/definitions/296.html"
        },
        {
          "label": "CWE-310",
          "url": "https://cwe.mitre.org/data/definitions/310.html"
        }
      ]
    },
    {
      "id": "A03-PYTHON-003",
      "name": "Injection — exec() / compile()",
      "summary": "5 patterns match injection in Python.",
      "description": "Use parameterised queries (`cursor.execute('SELECT … WHERE id = %s', (id,))`). Avoid `os.system` / `subprocess` with strings; pass argv lists. Use `ast.literal_eval` instead of `eval`.",
      "severity": "critical",
      "category": "A03",
      "cwe": [
        "CWE-20",
        "CWE-74",
        "CWE-75",
        "CWE-77",
        "CWE-78",
        "CWE-79",
        "CWE-80",
        "CWE-83",
        "CWE-87",
        "CWE-88",
        "CWE-89",
        "CWE-91",
        "CWE-94",
        "CWE-95",
        "CWE-96",
        "CWE-97",
        "CWE-98",
        "CWE-113",
        "CWE-116",
        "CWE-138"
      ],
      "patterns": [
        {
          "description": "exec() / compile()",
          "regex": "\\bexec\\s*\\(|\\bcompile\\s*\\(",
          "flags": "g"
        },
        {
          "description": "OS command built with concatenation",
          "regex": "\\b(?:os\\.system|subprocess\\.(?:run|call|check_output|Popen))\\s*\\([^)]*\\+",
          "flags": "g"
        },
        {
          "description": "DB execute with f-string SQL",
          "regex": "\\b(?:cursor|conn|c)\\.(?:execute|executemany)\\s*\\(\\s*['\"][^'\"]*\\{[^}]*?\\}",
          "flags": "g"
        },
        {
          "description": "String-format into SQL/command",
          "regex": "\\.format\\(\\s*[^)]*\\)\\s*$",
          "flags": "g"
        },
        {
          "description": "subprocess with shell=True",
          "regex": "subprocess\\.[A-Za-z_]+\\([^)]*shell\\s*=\\s*True",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Injection",
        "hint": "Use parameterised queries (`cursor.execute('SELECT … WHERE id = %s', (id,))`). Avoid `os.system` / `subprocess` with strings; pass argv lists. Use `ast.literal_eval` instead of `eval`.",
        "docUrl": "https://owasp.org/Top10/A03_2021-Injection/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A03",
          "url": "https://owasp.org/Top10/A03_2021-Injection/"
        },
        {
          "label": "CWE-20",
          "url": "https://cwe.mitre.org/data/definitions/20.html"
        },
        {
          "label": "CWE-74",
          "url": "https://cwe.mitre.org/data/definitions/74.html"
        },
        {
          "label": "CWE-75",
          "url": "https://cwe.mitre.org/data/definitions/75.html"
        }
      ]
    },
    {
      "id": "A04-PYTHON-004",
      "name": "Insecure Design — Security TODO/FIXME",
      "summary": "2 patterns match insecure design in Python.",
      "description": "Add rate-limits with Flask-Limiter / SlowAPI. Resolve security-related TODO/FIXME comments before shipping. Never use `assert` to enforce a security invariant — `python -O` strips assertions entirely, so the check silently disappears in production.",
      "severity": "medium",
      "category": "A04",
      "cwe": [
        "CWE-209",
        "CWE-256",
        "CWE-501",
        "CWE-522"
      ],
      "patterns": [
        {
          "description": "Security TODO/FIXME",
          "regex": "\\b(TODO|FIXME|XXX|HACK)\\b[^\\n]{0,80}?(?:auth|password|security|crypto|secret)",
          "flags": "g"
        },
        {
          "description": "assert used as a security check",
          "regex": "^\\s*assert\\s+(?:isinstance|hasattr|getattr)\\(",
          "flags": "mg"
        }
      ],
      "fix": {
        "title": "Remediate Insecure Design",
        "hint": "Add rate-limits with Flask-Limiter / SlowAPI. Resolve security-related TODO/FIXME comments before shipping. Never use `assert` to enforce a security invariant — `python -O` strips assertions entirely, so the check silently disappears in production.",
        "docUrl": "https://owasp.org/Top10/A04_2021-Insecure_Design/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A04",
          "url": "https://owasp.org/Top10/A04_2021-Insecure_Design/"
        },
        {
          "label": "CWE-209",
          "url": "https://cwe.mitre.org/data/definitions/209.html"
        },
        {
          "label": "CWE-256",
          "url": "https://cwe.mitre.org/data/definitions/256.html"
        },
        {
          "label": "CWE-501",
          "url": "https://cwe.mitre.org/data/definitions/501.html"
        }
      ]
    },
    {
      "id": "A05-PYTHON-005",
      "name": "Security Misconfiguration — Wildcard ACAO header",
      "summary": "2 patterns match security misconfiguration in Python.",
      "description": "Set DEBUG = False in production. Restrict CORS to known origins. Set ALLOWED_HOSTS explicitly.",
      "severity": "medium",
      "category": "A05",
      "cwe": [
        "CWE-2",
        "CWE-11",
        "CWE-13",
        "CWE-15",
        "CWE-16",
        "CWE-260",
        "CWE-315",
        "CWE-520",
        "CWE-526",
        "CWE-537",
        "CWE-541",
        "CWE-547",
        "CWE-611",
        "CWE-614",
        "CWE-756",
        "CWE-776",
        "CWE-942",
        "CWE-1004",
        "CWE-1032"
      ],
      "patterns": [
        {
          "description": "Wildcard ACAO header",
          "regex": "Access-Control-Allow-Origin['\":\\s]+['\"`]\\*['\"`]",
          "flags": "g"
        },
        {
          "description": "Django DEBUG = True",
          "regex": "\\bDEBUG\\s*=\\s*True\\b",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Security Misconfiguration",
        "hint": "Set DEBUG = False in production. Restrict CORS to known origins. Set ALLOWED_HOSTS explicitly.",
        "docUrl": "https://owasp.org/Top10/A05_2021-Security_Misconfiguration/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A05",
          "url": "https://owasp.org/Top10/A05_2021-Security_Misconfiguration/"
        },
        {
          "label": "CWE-2",
          "url": "https://cwe.mitre.org/data/definitions/2.html"
        },

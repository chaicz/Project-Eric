        "CWE-829",
        "CWE-830",
        "CWE-915"
      ],
      "patterns": [
        {
          "description": "Marshal.load/restore",
          "regex": "\\bMarshal\\.(?:load|restore)\\s*\\(",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Software and Data Integrity Failures",

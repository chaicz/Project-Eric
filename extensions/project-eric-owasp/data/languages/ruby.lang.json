        },
        {
          "label": "CWE-287",
          "url": "https://cwe.mitre.org/data/definitions/287.html"
        }
      ]
    },
    {
      "id": "A08-RUBY-006",
      "name": "Software and Data Integrity Failures — Marshal.load/restore",
      "summary": "Marshal.load/restore detected in Ruby source.",
      "description": "Never `Marshal.load` untrusted bytes. Use JSON + schema validation.",
      "severity": "high",
      "category": "A08",

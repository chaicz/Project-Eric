    {
      "id": "A10-GO-007",
      "name": "Server-Side Request Forgery (SSRF) — http.Get/Post with variable",
      "summary": "http.Get/Post with variable detected in Go source.",
      "description": "Validate and allowlist outbound URLs. Resolve DNS yourself to block private IPs. Disable HTTP redirects (`client.CheckRedirect = func(...) error { return http.ErrUseLastResponse }`).",
      "severity": "high",
      "category": "A10",
      "cwe": [
        "CWE-918"
      ],
      "patterns": [
        {
          "description": "http.Get/Post with variable",
          "regex": "http\\.(?:Get|Post|NewRequest)\\s*\\(\\s*[a-zA-Z_][\\w.]*\\s*\\)",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Server-Side Request Forgery (SSRF)",
        "hint": "Validate and allowlist outbound URLs. Resolve DNS yourself to block private IPs. Disable HTTP redirects (`client.CheckRedirect = func(...) error { return http.ErrUseLastResponse }`).",
        "docUrl": "https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/"
      },
      "safeToAutoFix": false,

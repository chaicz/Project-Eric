        }
      ]
    },
    {
      "id": "A09-CSHARP-006",
      "name": "Security Logging and Monitoring Failures — Console.WriteLine",
      "summary": "Console.WriteLine detected in C# source.",
      "description": "Use `ILogger<T>` with structured logging (Serilog / NLog). Log auth, admin and data-modification events with user id and IP.",

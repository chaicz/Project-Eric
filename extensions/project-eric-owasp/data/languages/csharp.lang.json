        },
        {
          "label": "CWE-11",
          "url": "https://cwe.mitre.org/data/definitions/11.html"
        },
        {
          "label": "CWE-13",
          "url": "https://cwe.mitre.org/data/definitions/13.html"
        }
      ]
    },
    {
      "id": "A07-CSHARP-005",
      "name": "Identification and Authentication Failures — Equals on password",
      "summary": "Equals on password detected in C# source.",
      "description": "Use BCrypt.Net / Argon2. Use `CryptographicOperations.FixedTimeEquals` for compare. Enforce MFA.",
      "severity": "high",
      "category": "A07",
      "cwe": [
        "CWE-255",
        "CWE-259",
        "CWE-287",
        "CWE-288",
        "CWE-290",
        "CWE-294",
        "CWE-295",
        "CWE-297",
        "CWE-300",
        "CWE-302",
        "CWE-304",
        "CWE-306",
        "CWE-307",
        "CWE-346",
        "CWE-384",
        "CWE-521",
        "CWE-613",
        "CWE-620",
        "CWE-640",
        "CWE-798",
        "CWE-940",
        "CWE-1216"
      ],
      "patterns": [
        {
          "description": "Equals on password",
          "regex": "\\b(?:==|Equals)\\s*\\(\\s*[\"']?(?:password|passwd|pwd)[\"']?",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Identification and Authentication Failures",
        "hint": "Use BCrypt.Net / Argon2. Use `CryptographicOperations.FixedTimeEquals` for compare. Enforce MFA.",

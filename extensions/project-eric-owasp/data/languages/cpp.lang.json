{
  "id": "cpp",
  "label": "C++",
  "extensions": [
    "cpp",
    "cc",
    "cxx"
  ],
  "flags": "g",
  "rules": [
    {
      "id": "A02-CPP-001",
      "name": "Cryptographic Failures — OpenSSL weak hash API",
      "summary": "2 patterns match cryptographic failures in C++.",
      "description": "Use SHA-256 / SHA-3 via `EVP_sha256()`. Replace gets/strcpy/sprintf with fgets/strlcpy/snprintf or std::string (Rust) / std::array<char,N>.",
      "severity": "high",
      "category": "A02",
      "cwe": [
        "CWE-261",
        "CWE-296",
        "CWE-310",
        "CWE-319",
        "CWE-321",
        "CWE-326",
        "CWE-327",
        "CWE-328",
        "CWE-330",
        "CWE-916"
      ],
      "patterns": [
        {
          "description": "OpenSSL weak hash API",
          "regex": "MD5_Init\\s*\\(|SHA1_Init\\s*\\(|EVP_md5\\(\\)|EVP_sha1\\(\\)",
          "flags": "g"
        },
        {
          "description": "Unsafe C string function (gets/strcpy/strcat/sprintf)",
          "regex": "\\bgets\\s*\\(|\\bstrcpy\\s*\\(|\\bstrcat\\s*\\(|\\bsprintf\\s*\\(",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Cryptographic Failures",
        "hint": "Use SHA-256 / SHA-3 via `EVP_sha256()`. Replace gets/strcpy/sprintf with fgets/strlcpy/snprintf or std::string (Rust) / std::array<char,N>.",
        "docUrl": "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A02",
          "url": "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/"
        },
        {
          "label": "CWE-261",
          "url": "https://cwe.mitre.org/data/definitions/261.html"
        },
        {
          "label": "CWE-296",
          "url": "https://cwe.mitre.org/data/definitions/296.html"
        },
        {
          "label": "CWE-310",
          "url": "https://cwe.mitre.org/data/definitions/310.html"
        }
      ]
    },
    {
      "id": "A03-CPP-002",
      "name": "Injection — C/C++ system/popen/exec",
      "summary": "C/C++ system/popen/exec detected in C++ source.",
      "description": "Avoid system()/popen(). Use execve() with an allowlisted argv list and avoid shell metacharacters.",
      "severity": "critical",
      "category": "A03",
      "cwe": [
        "CWE-20",
        "CWE-74",
        "CWE-75",
        "CWE-77",
        "CWE-78",
        "CWE-79",
        "CWE-80",
        "CWE-83",
        "CWE-87",
        "CWE-88",
        "CWE-89",
        "CWE-91",
        "CWE-94",
        "CWE-95",
        "CWE-96",
        "CWE-97",
        "CWE-98",
        "CWE-113",
        "CWE-116",
        "CWE-138"
      ],
      "patterns": [
        {
          "description": "C/C++ system/popen/exec",
          "regex": "\\b(?:system|popen|exec\\w*)\\s*\\(",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Injection",
        "hint": "Avoid system()/popen(). Use execve() with an allowlisted argv list and avoid shell metacharacters.",
        "docUrl": "https://owasp.org/Top10/A03_2021-Injection/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A03",
          "url": "https://owasp.org/Top10/A03_2021-Injection/"
        },
        {
          "label": "CWE-20",
          "url": "https://cwe.mitre.org/data/definitions/20.html"
        },
        {
          "label": "CWE-74",
          "url": "https://cwe.mitre.org/data/definitions/74.html"
        },
        {
          "label": "CWE-75",
          "url": "https://cwe.mitre.org/data/definitions/75.html"
        }
      ]
    },
    {
      "id": "A05-CPP-003",
      "name": "Security Misconfiguration — Wildcard ACAO header",
      "summary": "Wildcard ACAO header detected in C++ source.",
      "description": "Return ACAO with an explicit origin allowlist, never '*'. Strip debug info with `-DNDEBUG`.",
      "severity": "medium",
      "category": "A05",
      "cwe": [
        "CWE-2",
        "CWE-11",
        "CWE-13",
        "CWE-15",
        "CWE-16",
        "CWE-260",
        "CWE-315",
        "CWE-520",
        "CWE-526",
        "CWE-537",
        "CWE-541",
        "CWE-547",
        "CWE-611",
        "CWE-614",
        "CWE-756",
        "CWE-776",
        "CWE-942",
        "CWE-1004",
        "CWE-1032"
      ],
      "patterns": [
        {
          "description": "Wildcard ACAO header",
          "regex": "Access-Control-Allow-Origin['\":\\s]+['\"`]\\*['\"`]",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Security Misconfiguration",
        "hint": "Return ACAO with an explicit origin allowlist, never '*'. Strip debug info with `-DNDEBUG`.",
        "docUrl": "https://owasp.org/Top10/A05_2021-Security_Misconfiguration/"
      },
      "safeToAutoFix": false,
      "references": [
        {
          "label": "OWASP A05",
          "url": "https://owasp.org/Top10/A05_2021-Security_Misconfiguration/"
        },
        {
          "label": "CWE-2",
          "url": "https://cwe.mitre.org/data/definitions/2.html"
        },
        {
          "label": "CWE-11",
          "url": "https://cwe.mitre.org/data/definitions/11.html"
        },
        {
          "label": "CWE-13",
          "url": "https://cwe.mitre.org/data/definitions/13.html"
        }
      ]
    }
  ]
}

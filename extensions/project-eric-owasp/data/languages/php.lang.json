        },
        {
          "label": "CWE-259",
          "url": "https://cwe.mitre.org/data/definitions/259.html"
        },
        {
          "label": "CWE-287",
          "url": "https://cwe.mitre.org/data/definitions/287.html"
        }
      ]
    },
    {
      "id": "A09-PHP-006",
      "name": "Security Logging and Monitoring Failures — var_dump/print_r",
      "summary": "var_dump/print_r detected in PHP source.",
      "description": "Use Laravel's Log facade (`Log::info(...)`) or Monolog. Log auth + admin events with user id and IP.",
      "severity": "low",
      "category": "A09",
      "cwe": [
        "CWE-117",
        "CWE-223",
        "CWE-532",
        "CWE-778"
      ],
      "patterns": [
        {
          "description": "var_dump/print_r",
          "regex": "var_dump\\s*\\(|print_r\\s*\\(",
          "flags": "g"
        }
      ],
      "fix": {
        "title": "Remediate Security Logging and Monitoring Failures",
        "hint": "Use Laravel's Log facade (`Log::info(...)`) or Monolog. Log auth + admin events with user id and IP.",
